SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/defaultdb?sslMode=REQUIRED
DB_USERNAME=replace_with_database_username
DB_PASSWORD=replace_with_database_password
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/login/oauth2/code/google
# Set this in frontend/.env.local after AdSense issues your publisher ID.
VITE_GOOGLE_ADSENSE_CLIENT=ca-pub-0000000000000000
